import streamlit as st
import pandas as pd

import matplotlib.pyplot as plt
import plotly.express as px


#Pageconfiguration
#----------------------------
st.set_page_config(page_title="Titanic Dashboard",page_icon="🔬", layout="wide")

df= pd.read_csv(r"C:\Users\Arjun Singh\Downloads\Titanic-Dataset.csv")


st.title("The Titanic Dataset")

# Creating Filters

col1,col2, col3=st.columns(3)

with col1:
    gender=st.selectbox("Select Gender",["All","male","female"])
    if gender!="All":
        filtered_df =df[df["Sex"]==gender]
    else:
        filtered_df=df
with col2:
    pclass=st.selectbox("Select Passenger Class",["All",1,2,3])
    if pclass!="All":
        filtered_df =filtered_df[filtered_df["Pclass"]==pclass]

with col3:
    classes=st.multiselect("Select Passenger Class",[1,2,3])
    filtered_df= filtered_df[filtered_df["Pclass"].isin(classes)]



# Displaying Filtered Data
st.subheader("Filtered Titanic Data")
st.write("Passengers after filtering:", len(filtered_df))
st.dataframe(filtered_df)



