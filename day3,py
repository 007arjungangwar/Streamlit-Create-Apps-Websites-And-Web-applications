col1,col2,col3=st.columns(3)
with col1:
    avg_fare=filtered_df.groupby("Pclass")["Fare"].mean()
    st.subheader("AverageFarebyPassenger Class")
    st.line_chart(avg_fare)
with col2:
    class_counts=filtered_df["Pclass"].value_counts().sort_index()
    st.subheader("PassengersbyClass")
    st.bar_chart(class_counts)
with col3:
    survival=filtered_df.groupby("Pclass")["Survived"].sum()
    st.subheader("SurvivorsbyPassengerClass")
    st.area_chart(survival)



col1,col2,col3,col4=st.columns(4)

with col1:
    gender_counts = filtered_df["Sex"].value_counts()

    fig,ax=plt.subplots()
    ax.pie(gender_counts,labels=gender_counts.index,autopct="%1.1f%%",explode=[0.05,0])
    ax.set_title("Passenger Distribution by Gender")
    st.pyplot(fig)

with col2:
    fig,ax=plt.subplots()
    ax.scatter(filtered_df["Age"],filtered_df["Fare"])
    # ax.set_xlabel("Age")
    # ax.set_ylabel("Fare")
    ax.set_title("AgevsFare")
    st.pyplot(fig)

with col3:
    fig,ax=plt.subplots()
    ax.hist(filtered_df["Fare"],bins=30)
    # ax.set_xlabel("Fare")
    # ax.set_ylabel("NumberofPassengers")
    ax.set_title("FareDistribution")
    st.pyplot(fig)


with col4:
    fig,ax=plt.subplots()
    filtered_df.boxplot(column="Age",by="Pclass",ax=ax)
    ax.set_xlabel("PassengerClass")
    ax.set_ylabel("Age")
    ax.set_title("AgeDistributionbyPassengerClass")
    plt.suptitle("")
    st.pyplot(fig)



import plotly.express as px

col1,col2=st.columns(2)
with col1:
    fig=px.scatter(filtered_df,x="Age",y="Fare",title="Age vs Fare")
    st.plotly_chart(fig,use_container_width=True)

with col2:
    fig=px.scatter(filtered_df,x="Age",y="Fare",color="Sex",title="Age vs Fare by Gender")
    st.plotly_chart(fig,use_container_width=True)


col1,col2=st.columns(2)
with col1:
    fig=px.histogram(filtered_df,x="Age",nbins=20,title="Age Distribution")
    st.plotly_chart(fig,use_container_width=True)

with col2:
    fig=px.box(filtered_df,x="Pclass",y="Fare",title="Fare Distribution by Passenger Class")
